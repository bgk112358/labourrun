.page-steps {
  min-height: 100vh;
  padding-bottom: 130rpx;
  padding-bottom: calc(110rpx + env(safe-area-inset-bottom));
  background: #F7F7F7;
}

/* 兑换券条 */
.coupon-bar {
  height: 100rpx;
  padding: 0 32rpx;
  display: flex;
  align-items: center;
  background: #FFFFFF;
}
.coin {
  width: 52rpx;
  height: 52rpx;
  margin-right: 18rpx;
  border-radius: 50%;
  background: linear-gradient(145deg, #FFE08A, #F5A623);
  border: 4rpx solid #E8991B;
  box-shadow: inset 0 -4rpx 6rpx rgba(160, 100, 0, .2);
  color: #FFFFFF;
  font-size: 30rpx;
  font-weight: 700;
  line-height: 44rpx;
  text-align: center;
}
.coupon-label {
  font-size: 30rpx;
  font-weight: 500;
  color: #1A1A1A;
}
.coupon-value {
  margin-left: 20rpx;
  font-size: 32rpx;
  font-weight: 700;
  color: #F5A623;
}
.coupon-arrow {
  width: 16rpx;
  height: 16rpx;
  margin-left: auto;
  border-top: 4rpx solid #BBBBBB;
  border-right: 4rpx solid #BBBBBB;
  transform: rotate(45deg);
}

/* 天空区 */
.sky {
  position: relative;
  height: 780rpx;
  overflow: hidden;
  background: linear-gradient(180deg, #6FA9DA 0%, #A9CFE8 55%, #DCEBF6 100%);
}
.sky-left {
  position: absolute;
  left: 24rpx;
  top: 28rpx;
  z-index: 3;
}
.sky-entry {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
  font-size: 24rpx;
  font-weight: 700;
  color: #F5A623;
  text-shadow: 0 2rpx 4rpx rgba(0, 0, 0, .15);
}
.trophy {
  position: relative;
  width: 36rpx;
  height: 40rpx;
  margin-right: 10rpx;
}
.trophy-cup {
  position: absolute;
  top: 0;
  left: 6rpx;
  width: 24rpx;
  height: 20rpx;
  border-radius: 0 0 14rpx 14rpx;
  background: #F5A623;
}
.trophy-stem {
  position: absolute;
  top: 20rpx;
  left: 16rpx;
  width: 4rpx;
  height: 10rpx;
  background: #F5A623;
}
.trophy-base {
  position: absolute;
  bottom: 2rpx;
  left: 8rpx;
  width: 20rpx;
  height: 6rpx;
  border-radius: 4rpx;
  background: #F5A623;
}
.mini-house {
  position: relative;
  width: 36rpx;
  height: 36rpx;
  margin-right: 10rpx;
}
.mini-roof {
  position: absolute;
  top: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 0;
  height: 0;
  border-left: 18rpx solid transparent;
  border-right: 18rpx solid transparent;
  border-bottom: 14rpx solid #F5A623;
}
.mini-body {
  position: absolute;
  bottom: 2rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 24rpx;
  height: 18rpx;
  background: #F5A623;
  border-radius: 2rpx;
}
.rule-capsule {
  position: absolute;
  right: 24rpx;
  top: 28rpx;
  z-index: 3;
  padding: 8rpx 26rpx;
  border-radius: 30rpx;
  background: rgba(90, 126, 158, .6);
  color: #FFFFFF;
  font-size: 24rpx;
}

.hill {
  position: absolute;
  bottom: -40rpx;
  border-radius: 50% 50% 0 0;
}
.hill-back {
  left: -120rpx;
  width: 560rpx;
  height: 150rpx;
  background: #B7D9A8;
}
.hill-front {
  right: -140rpx;
  width: 600rpx;
  height: 180rpx;
  background: #A5CE96;
}
.tree {
  position: absolute;
  bottom: 60rpx;
  width: 40rpx;
  height: 80rpx;
  z-index: 2;
}
.tree-a { left: 80rpx; }
.tree-b { right: 100rpx; bottom: 90rpx; transform: scale(.8); }
.trunk {
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 8rpx;
  height: 30rpx;
  background: #8B6A4B;
}
.leaf {
  position: absolute;
  left: 50%;
  transform: translateX(-50%);
  border-radius: 50%;
  background: #6FAE66;
}
.leaf-1 { top: 12rpx; width: 40rpx; height: 36rpx; }
.leaf-2 { top: 0; width: 30rpx; height: 28rpx; background: #7FBE74; }

/* 表盘 */
.dial {
  position: absolute;
  left: 50%;
  top: 150rpx;
  transform: translateX(-50%);
  width: 440rpx;
  height: 440rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, .10);
  border: 4rpx solid rgba(255, 255, 255, .45);
  z-index: 4;
}
.dial-ticks {
  position: absolute;
  inset: 0;
}
.tick {
  position: absolute;
  left: 50%;
  top: 4rpx;
  width: 4rpx;
  height: 16rpx;
  margin-left: -2rpx;
  border-radius: 2rpx;
  background: #FFFFFF;
  transform-origin: 2rpx 216rpx;
}
.dial-inner {
  position: absolute;
  left: 50%;
  top: 50%;
  transform: translate(-50%, -50%);
  width: 330rpx;
  height: 330rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, .92);
  box-shadow: 0 8rpx 24rpx rgba(31, 76, 120, .15);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}
.dial-label {
  font-size: 30rpx;
  color: #333333;
  line-height: 1.4;
}
.dial-number {
  margin-top: 6rpx;
  font-size: 96rpx;
  font-weight: 800;
  line-height: 1.1;
  color: #E93B33;
}
.dial-action {
  margin-top: 10rpx;
  padding: 8rpx 32rpx;
  border-radius: 30rpx;
  background: linear-gradient(90deg, #F4533F, #F98C76);
  color: #FFFFFF;
  font-size: 28rpx;
  font-weight: 700;
  line-height: 1.4;
}
.dial-tip {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #999999;
}
.sync {
  position: absolute;
  left: 50%;
  top: 620rpx;
  transform: translateX(-50%);
  z-index: 4;
  display: flex;
  align-items: center;
  color: #FFFFFF;
  font-size: 24rpx;
}
.refresh {
  margin-right: 10rpx;
  font-size: 30rpx;
  line-height: 1;
}

/* 邀请胶囊 */
.invite-btn {
  width: 600rpx;
  height: 96rpx;
  margin: 28rpx auto 0;
  border-radius: 48rpx;
  background: linear-gradient(90deg, #F5A623, #F7BE56);
  box-shadow: 0 10rpx 20rpx rgba(245, 166, 35, .28);
  color: #FFFFFF;
  font-size: 32rpx;
  font-weight: 700;
  line-height: 96rpx;
  text-align: center;
}

/* 好友助力卡 */
.friend-card {
  position: relative;
  width: 710rpx;
  margin: 24rpx auto 0;
  padding: 24rpx 140rpx 24rpx 0;
  min-height: 240rpx;
  background: #FFFFFF;
  border-radius: 24rpx;
  box-shadow: 0 6rpx 18rpx rgba(0, 0, 0, .04);
  overflow: hidden;
}
.friend-left {
  display: flex;
  flex-direction: column;
  padding-left: 20rpx;
}
.friend-top {
  display: flex;
  align-items: flex-start;
}
.friend-titles {
  flex: none;
  width: 90rpx;
  padding: 12rpx 0;
  display: flex;
  flex-direction: column;
  font-size: 28rpx;
  font-weight: 700;
  line-height: 1.5;
  color: #A9601B;
  background: linear-gradient(135deg, #FFF0DC, #FFE2C0);
  border-radius: 12rpx 0 0 12rpx;
  text-align: center;
}
.friend-adds {
  flex: 1;
  display: flex;
  justify-content: space-around;
  padding: 6rpx 10rpx 0 18rpx;
}
.add-plus {
  width: 96rpx;
  height: 96rpx;
  border: 4rpx solid #F5A623;
  border-radius: 20rpx;
  color: #F5A623;
  font-size: 52rpx;
  font-weight: 300;
  line-height: 88rpx;
  text-align: center;
}
.friend-stats {
  display: flex;
  flex-direction: column;
  margin-top: 16rpx;
  font-size: 24rpx;
  line-height: 1.7;
  color: #999999;
}
.friend-more {
  position: absolute;
  right: 20rpx;
  top: 50%;
  transform: translateY(-50%);
  width: 100rpx;
  padding: 16rpx 0;
  border-radius: 30rpx;
  background: #F1F1F1;
  color: #777777;
  font-size: 24rpx;
  line-height: 1.5;
  text-align: center;
}

/* 每日兑换提醒 */
.reminder-card {
  display: flex;
  align-items: center;
  width: 710rpx;
  margin: 24rpx auto 0;
  padding: 28rpx 30rpx;
  background: #FFFFFF;
  border-radius: 24rpx;
}
.reminder-info { flex: 1; }
.reminder-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #1A1A1A;
}
.reminder-sub {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #999999;
}
.switch {
  flex: none;
  width: 88rpx;
  height: 48rpx;
  margin-left: 20rpx;
  padding: 4rpx;
  border-radius: 24rpx;
  background: #DDDDDD;
}
.switch-knob {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background: #FFFFFF;
  box-shadow: 0 2rpx 6rpx rgba(0, 0, 0, .15);
}

/* 步数挑战 */
.challenge-card {
  width: 710rpx;
  margin: 24rpx auto 0;
  padding: 28rpx 28rpx 30rpx;
  background: #FFFFFF;
  border-radius: 24rpx;
}
.challenge-head {
  display: flex;
  align-items: center;
}
.challenge-bar {
  width: 8rpx;
  height: 34rpx;
  margin-right: 14rpx;
  border-radius: 4rpx;
  background: #F5A623;
}
.challenge-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #1A1A1A;
}
.challenge-date {
  margin-left: 20rpx;
  font-size: 24rpx;
  color: #999999;
}
.challenge-more {
  margin-left: auto;
  font-size: 24rpx;
  color: #999999;
}
.challenge-body {
  display: flex;
  align-items: center;
  margin-top: 20rpx;
}
.runners {
  position: relative;
  flex: none;
  width: 260rpx;
  height: 180rpx;
  overflow: hidden;
}
.grass {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  height: 40rpx;
  border-radius: 50% 50% 0 0;
  background: #A8D08D;
}
.runner {
  position: absolute;
  bottom: 26rpx;
  width: 40rpx;
  height: 100rpx;
}
.runner-blue { left: 46rpx; }
.runner-orange { right: 46rpx; }
.r-head {
  position: absolute;
  top: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 26rpx;
  height: 26rpx;
  border-radius: 50%;
  background: #F2C9A0;
}
.r-body {
  position: absolute;
  top: 28rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 30rpx;
  height: 42rpx;
  border-radius: 12rpx;
}
.runner-blue .r-body { background: #4A90D9; }
.runner-orange .r-body { background: #F5A623; }
.r-leg {
  position: absolute;
  top: 66rpx;
  width: 8rpx;
  height: 34rpx;
  border-radius: 4rpx;
  background: #3B4756;
}
.leg-a { left: 10rpx; transform: rotate(24deg); }
.leg-b { right: 10rpx; transform: rotate(-24deg); }
.r-arm {
  position: absolute;
  top: 32rpx;
  width: 8rpx;
  height: 30rpx;
  border-radius: 4rpx;
  background: #F2C9A0;
}
.arm-a { left: -4rpx; transform: rotate(30deg); }
.arm-b { right: -4rpx; transform: rotate(-30deg); }
.challenge-info {
  flex: 1;
  padding-left: 12rpx;
}
.goal {
  font-size: 28rpx;
  color: #1A1A1A;
}
.goal-num {
  margin: 0 6rpx;
  font-size: 40rpx;
  font-weight: 800;
  color: #E93B33;
}
.deposit {
  margin-top: 14rpx;
  font-size: 26rpx;
  color: #F5A623;
}
.joined {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #999999;
}
.challenge-btn {
  width: 100%;
  height: 72rpx;
  margin-top: 24rpx;
  border: 2rpx solid #F5A623;
  border-radius: 36rpx;
  color: #F5A623;
  font-size: 28rpx;
  font-weight: 600;
  line-height: 68rpx;
  text-align: center;
}
