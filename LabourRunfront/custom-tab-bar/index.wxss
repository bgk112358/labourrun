.tabbar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 1000;
  background: #FFFFFF;
  box-shadow: 0 -2rpx 12rpx rgba(0, 0, 0, .05);
}
.tabbar-inner {
  height: 98rpx;
  display: flex;
  align-items: stretch;
}
.tab-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: #999999;
}
.tab-hover { opacity: .7; }
.tab-item.active { color: #E93B33; }
.tab-icon {
  position: relative;
  width: 44rpx;
  height: 44rpx;
}
.tab-text {
  margin-top: 6rpx;
  font-size: 24rpx;
  line-height: 1;
}

/* 首页：尖顶房子 */
.roof {
  position: absolute;
  top: 2rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 0;
  height: 0;
  border-left: 22rpx solid transparent;
  border-right: 22rpx solid transparent;
  border-bottom: 18rpx solid currentColor;
}
.house {
  position: absolute;
  bottom: 2rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 30rpx;
  height: 22rpx;
  background: currentColor;
  border-radius: 2rpx;
}

/* 步数宝：2×2 方块，选中时右上/左下实心 */
.sq {
  position: absolute;
  width: 18rpx;
  height: 18rpx;
  border: 3rpx solid currentColor;
  border-radius: 2rpx;
}
.sq-tl { left: 2rpx; top: 2rpx; }
.sq-tr { right: 2rpx; top: 2rpx; }
.sq-bl { left: 2rpx; bottom: 2rpx; }
.sq-br { right: 2rpx; bottom: 2rpx; }
.active .sq-tr,
.active .sq-bl { background: currentColor; }

/* 我：人形 */
.person-head {
  position: absolute;
  top: 3rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: currentColor;
}
.person-body {
  position: absolute;
  bottom: 2rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 32rpx;
  height: 20rpx;
  border-radius: 16rpx 16rpx 4rpx 4rpx;
  background: currentColor;
}
