.page-challenge {
  min-height: 100vh;
  padding: 20rpx 30rpx 60rpx;
  background: #F7F7F7;
}

.challenge-hero {
  padding: 32rpx;
  border-radius: 24rpx;
  background: linear-gradient(135deg, #2F6DB5, #6FA9DA);
  box-shadow: 0 12rpx 28rpx rgba(47, 109, 181, .2);
  color: #FFFFFF;
}

.hero-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.hero-title {
  font-size: 38rpx;
  font-weight: 700;
}

.status-pill {
  padding: 6rpx 18rpx;
  border-radius: 20rpx;
  background: rgba(255, 255, 255, .2);
  font-size: 22rpx;
}

.hero-date {
  margin-top: 12rpx;
  color: rgba(255, 255, 255, .85);
  font-size: 24rpx;
}

.hero-metrics {
  display: flex;
  margin-top: 32rpx;
}

.metric {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.metric + .metric {
  border-left: 1rpx solid rgba(255, 255, 255, .25);
}

.metric-num {
  font-size: 40rpx;
  font-weight: 800;
}

.metric-label {
  margin-top: 6rpx;
  color: rgba(255, 255, 255, .8);
  font-size: 22rpx;
}

.rules-panel {
  margin-top: 24rpx;
  padding: 28rpx;
  border-radius: 24rpx;
  background: #FFFFFF;
}

.panel-title {
  margin-bottom: 20rpx;
  color: #1A1A1A;
  font-size: 30rpx;
  font-weight: 700;
}

.challenge-rule {
  display: flex;
  gap: 16rpx;
  padding: 18rpx 0;
  border-top: 1rpx solid #F0F0F0;
}

.challenge-rule:first-of-type {
  border-top: none;
}

.rule-index {
  flex: none;
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background: #3E82CC;
  color: #FFFFFF;
  font-size: 22rpx;
  line-height: 40rpx;
  text-align: center;
}

.rule-content {
  flex: 1;
}

.rule-title {
  color: #1A1A1A;
  font-size: 28rpx;
  font-weight: 600;
}

.rule-text {
  margin-top: 8rpx;
  color: #666666;
  font-size: 26rpx;
  line-height: 1.7;
}

.empty-tip {
  padding: 20rpx 0;
  color: #999999;
  font-size: 24rpx;
  text-align: center;
}

.notice-box {
  margin-top: 24rpx;
  padding: 20rpx 24rpx;
  border-radius: 16rpx;
  background: #FFF8E8;
  color: #A9601B;
  font-size: 24rpx;
  line-height: 1.7;
}

.share-btn {
  width: 100%;
  height: 88rpx;
  margin-top: 32rpx;
  padding: 0;
  border: none;
  border-radius: 44rpx;
  background: linear-gradient(90deg, #F5A623, #F7BE56);
  color: #FFFFFF;
  font-size: 30rpx;
  font-weight: 700;
  line-height: 88rpx;
  text-align: center;
}

.share-btn::after {
  border: none;
}

.loading-tip,
.error-bar {
  margin-bottom: 16rpx;
  padding: 14rpx 20rpx;
  border-radius: 10rpx;
  font-size: 24rpx;
  text-align: center;
}

.loading-tip {
  background: #FFFFFF;
  color: #999999;
}

.error-bar {
  background: #FFF1F0;
  border: 1rpx solid #FFCCC7;
  color: #E93B33;
}
