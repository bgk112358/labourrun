.page-home {
  min-height: 100vh;
  padding: 0 0 130rpx;
  padding-bottom: calc(110rpx + env(safe-area-inset-bottom));
  background: #F7F7F7;
}

/* 信息条：顶部被导航压住一半 */
.notice-strip {
  position: relative;
  z-index: 1;
  height: 92rpx;
  margin-top: -46rpx;
  padding: 0 40rpx 12rpx;
  display: flex;
  align-items: flex-end;
  background: linear-gradient(90deg, #FFF3EE 0%, #FFFFFF 70%);
}
.notice-badge {
  width: 40rpx;
  height: 40rpx;
  margin-right: 14rpx;
  border-radius: 10rpx;
  background: linear-gradient(135deg, #F4533F, #F98C76);
  color: #FFFFFF;
  font-size: 24rpx;
  line-height: 40rpx;
  text-align: center;
  box-shadow: 0 4rpx 10rpx rgba(244, 83, 63, .25);
}
.notice-text {
  font-size: 28rpx;
  color: #E93B33;
  font-weight: 600;
  line-height: 40rpx;
}

/* 后台配置的活动主图 */
.activity-banner {
  display: block;
  width: 690rpx;
  height: 368rpx;
  margin: 0 30rpx;
  border-radius: 20rpx;
  background: #D6E4F5;
}

/* 蓝色棋盘格区 */
.board {
  position: relative;
  height: 1000rpx;
  margin: 0 30rpx;
  border-radius: 20rpx;
  overflow: hidden;
  background-color: #D6E4F5;
  background-image:
    linear-gradient(45deg, #C6D9EF 25%, transparent 25%, transparent 75%, #C6D9EF 75%, #C6D9EF),
    linear-gradient(45deg, #C6D9EF 25%, transparent 25%, transparent 75%, #C6D9EF 75%, #C6D9EF);
  background-size: 80rpx 80rpx;
  background-position: 0 0, 40rpx 40rpx;
}
.mountain {
  position: absolute;
  bottom: 0;
  width: 0;
  height: 0;
  border-left: 160rpx solid transparent;
  border-right: 160rpx solid transparent;
  border-bottom: 260rpx solid #7FA9D8;
}
.mountain-a { left: -60rpx; opacity: .85; }
.mountain-b { left: 250rpx; border-bottom-color: #6C9BCE; }
.mountain-c { right: -90rpx; border-bottom-color: #8BB5E0; opacity: .8; }

.star {
  position: absolute;
  width: 56rpx;
  height: 56rpx;
  clip-path: polygon(50% 0%, 58% 42%, 100% 50%, 58% 58%, 50% 100%, 42% 58%, 0% 50%, 42% 42%);
}
.star-a { left: 70rpx; top: 110rpx; background: #F5A623; transform: rotate(12deg); }
.star-b { right: 90rpx; top: 90rpx; background: #B8C6D6; transform: rotate(-10deg) scale(.8); }
.star-c { left: 120rpx; bottom: 180rpx; background: #BAC9D9; transform: scale(.6); }
.star-d { right: 130rpx; bottom: 260rpx; background: #F5A623; transform: rotate(20deg) scale(.7); }

.sign {
  position: absolute;
  left: 50%;
  top: 300rpx;
  transform: translateX(-50%);
  width: 620rpx;
  height: 150rpx;
  border-radius: 18rpx;
  background: #FFFFFF;
  box-shadow: 0 12rpx 24rpx rgba(43, 86, 138, .18);
  font-size: 78rpx;
  font-weight: 800;
  line-height: 150rpx;
  text-align: center;
  color: #2F6DB5;
  letter-spacing: 8rpx;
}

.pencil {
  position: absolute;
  right: 70rpx;
  bottom: 70rpx;
  width: 36rpx;
  height: 230rpx;
  transform: rotate(40deg);
  transform-origin: center center;
  filter: drop-shadow(0 6rpx 8rpx rgba(0, 0, 0, .15));
}
.pencil-eraser {
  position: absolute;
  top: 0;
  left: 0;
  width: 36rpx;
  height: 26rpx;
  border-radius: 12rpx 12rpx 0 0;
  background: #F2A0A6;
}
.pencil-body {
  position: absolute;
  top: 26rpx;
  left: 0;
  width: 36rpx;
  height: 170rpx;
  background: linear-gradient(90deg, #F5B942, #F5A623 55%, #E59411);
}
.pencil-tip {
  position: absolute;
  bottom: 0;
  left: 0;
  width: 0;
  height: 0;
  border-left: 18rpx solid transparent;
  border-right: 18rpx solid transparent;
  border-top: 34rpx solid #E8C89A;
}

/* 须知卡 */
.rules-card {
  position: relative;
  margin: 30rpx 30rpx 0;
  padding: 48rpx 30rpx 36rpx;
  background: #FFFFFF;
  border: 3rpx solid #4C8FD6;
  border-radius: 24rpx;
}
.card-dots {
  position: absolute;
  left: 26rpx;
  top: 18rpx;
  display: flex;
  gap: 10rpx;
}
.dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
}
.dot-purple { background: #A87BD8; }
.dot-yellow { background: #F5C33B; }
.dot-pink { background: #F29BB6; }
.rule {
  display: flex;
  align-items: flex-start;
  margin-bottom: 24rpx;
}
.rule:last-child { margin-bottom: 0; }
.rule-badge {
  flex: none;
  width: 48rpx;
  height: 48rpx;
  margin-right: 16rpx;
  border-radius: 50%;
  background: #3E82CC;
  color: #FFFFFF;
  font-size: 24rpx;
  font-weight: 700;
  line-height: 48rpx;
  text-align: center;
}
.rule-text {
  flex: 1;
  font-size: 28rpx;
  line-height: 1.7;
  color: #1A1A1A;
}

/* 参赛报名标题 */
.section-title {
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 48rpx 60rpx 28rpx;
}
.title-line {
  flex: 1;
  height: 2rpx;
  background: #1A1A1A;
}
.title-text {
  margin: 0 24rpx;
  font-size: 32rpx;
  font-weight: 700;
  color: #1A1A1A;
  letter-spacing: 2rpx;
}

/* 报名表单 */
.form-list {
  padding: 0 30rpx;
}
.form-row {
  width: 690rpx;
  height: 100rpx;
  margin-bottom: 18rpx;
  padding: 0 28rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: #FFFFFF;
  border-radius: 12rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, .03);
}
.form-label {
  font-size: 30rpx;
  font-weight: 600;
  color: #1A1A1A;
}
.required {
  margin-left: 6rpx;
  color: #E93B33;
  font-size: 32rpx;
}
.form-placeholder {
  font-size: 28rpx;
  color: #BBBBBB;
}
.form-right {
  display: flex;
  align-items: center;
}
.form-hint {
  margin-left: 16rpx;
  padding-left: 16rpx;
  border-left: 2rpx solid #EEEEEE;
  font-size: 26rpx;
  color: #999999;
}

/* 报名输入与状态 */
.page-home {
  padding-bottom: calc(260rpx + env(safe-area-inset-bottom));
}

.form-input {
  flex: 1;
  height: 60rpx;
  margin-left: 20rpx;
  color: #1A1A1A;
  font-size: 28rpx;
  text-align: right;
}

.phone-input {
  min-width: 0;
}

.form-right {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: flex-end;
  min-width: 0;
}

.reg-status {
  width: 690rpx;
  margin: 0 auto 18rpx;
  padding: 12rpx 20rpx;
  border-radius: 10rpx;
  background: #F1F5F9;
  color: #64748B;
  font-size: 24rpx;
  text-align: center;
}

.reg-status.is-registered {
  background: #FFF3EE;
  color: #E93B33;
}

.reg-status.is-cancelled {
  background: #F5F5F5;
  color: #999999;
}

/* 奖品兑换 */
.reward-section {
  margin-top: 8rpx;
}
.reward-list {
  padding: 0 30rpx;
}
.reward-row {
  display: flex;
  align-items: center;
  margin-bottom: 18rpx;
  padding: 20rpx;
  background: #FFFFFF;
  border-radius: 16rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, .03);
}
.reward-image {
  flex: none;
  width: 150rpx;
  height: 150rpx;
  border-radius: 14rpx;
  background: #F1F5F9;
}
.reward-placeholder {
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, #FFF3EE, #FFE1D8);
}
.reward-placeholder-mark {
  font-size: 56rpx;
  font-weight: 700;
  color: #E93B33;
}
.reward-main {
  flex: 1;
  min-width: 0;
  margin-left: 22rpx;
}
.reward-name {
  font-size: 30rpx;
  font-weight: 700;
  color: #1A1A1A;
  line-height: 1.4;
}
.reward-cost {
  margin-top: 14rpx;
  font-size: 26rpx;
  color: #E93B33;
}
.reward-action {
  flex: none;
  min-width: 150rpx;
  height: 64rpx;
  margin-left: 16rpx;
  padding: 0 18rpx;
  border-radius: 32rpx;
  background: linear-gradient(90deg, #F4533F, #F98C76);
  color: #FFFFFF;
  font-size: 26rpx;
  line-height: 64rpx;
  text-align: center;
}
.reward-action.is-detail {
  border: 2rpx solid #F7C9BE;
  background: #FFF3EE;
  color: #E93B33;
  line-height: 60rpx;
}
.reward-action.is-disabled {
  background: #E5E7EB;
  color: #9CA3AF;
}
.reward-action.is-loading {
  opacity: .7;
}

.submit-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: calc(98rpx + env(safe-area-inset-bottom));
  z-index: 900;
  padding: 16rpx 30rpx;
  background: #FFFFFF;
  box-shadow: 0 -2rpx 12rpx rgba(0, 0, 0, .05);
}

.submit-btn {
  width: 100%;
  height: 88rpx;
  padding: 0;
  border-radius: 44rpx;
  background: linear-gradient(90deg, #F4533F, #F98C76);
  color: #FFFFFF;
  font-size: 30rpx;
  font-weight: 600;
  line-height: 88rpx;
}

.submit-btn::after {
  border: none;
}

.submit-btn[disabled] {
  background: linear-gradient(90deg, #F4533F, #F98C76);
  color: #FFFFFF;
  opacity: .6;
}

.cancel-link {
  margin-top: 14rpx;
  color: #999999;
  font-size: 26rpx;
  text-align: center;
}

.error-bar,
.loading-tip {
  margin: 16rpx 30rpx 0;
  padding: 14rpx 20rpx;
  border-radius: 10rpx;
  font-size: 24rpx;
  text-align: center;
}

.error-bar {
  background: #FFF1F0;
  border: 1rpx solid #FFCCC7;
  color: #E93B33;
}

.loading-tip {
  background: #FFFFFF;
  color: #999999;
}
